<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app is an HTTP client of the local backend. It is deliberately NOT
         sandboxed: it spawns the backend process and reads generated media from
         arbitrary paths, which App Sandbox would block. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
